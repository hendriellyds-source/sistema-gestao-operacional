# Sistema de Gestão Operacional — Portfolio Demo
# Copie este arquivo para .env. A configuração abaixo funciona sem serviços externos.

DEMO_MODE=true
DEMO_EMAIL=demo@portfolio.local
DEMO_PASSWORD=demo1234
DEMO_DISPLAY_NAME=Recrutador Demo
AUTH_COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo
POLL_INTERVAL_SECONDS=10

# Integrações externas — desabilitadas no portfólio por padrão
SELSYN_BASE_URL=
SELSYN_API_KEY=
SELSYN_TIMEOUT_SECONDS=30
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REQUEST_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
HISTORICAL_VISION_MODEL=gpt-4.1

CORA_ENABLED=false
CORA_ENVIRONMENT=sandbox
CORA_CLIENT_ID=
CORA_CERTIFICATE_PATH=
CORA_PRIVATE_KEY_PATH=
CORA_WEBHOOK_TOKEN=
CORA_WEBHOOK_PUBLIC_URL=

NFSE_IPM_ENABLED=false
NFSE_IPM_TEST_MODE=true
NFSE_IPM_CITY=
NFSE_IPM_USERNAME=
NFSE_IPM_PASSWORD=
NFSE_PROVIDER_CNPJ=
NFSE_PROVIDER_MUNICIPAL_REGISTRATION=
NFSE_PROVIDER_CITY_CODE=

WHATSAPP_ENABLED=false
WHATSAPP_AUTO_MENU_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_MOBILE_SENDER_NAME=Equipe Demo

# Contato demonstrativo
PUBLIC_CONTACT_EMAIL=contato@example.com
PUBLIC_CONTACT_PHONE=(00) 00000-0000
PUBLIC_WHATSAPP_URL=
PUBLIC_INSTAGRAM_HANDLE=@portfolio.demo
PUBLIC_INSTAGRAM_URL=

# Armazenamento local
EMPLOYEE_PORTAL_DB_PATH=data/employee_portal.db
DOCUMENTS_DB_PATH=data/documents.db
DOCUMENTS_ROOT_PATH=data/documents
SYSTEM_STATE_DB_PATH=data/system_state.db
AUTH_DB_PATH=data/system_auth.db
ALINE_DB_PATH=data/aline_projects.db
AUDIT_DB_PATH=data/audit.db
HISTORY_DB_PATH=data/history.db
TRACKER_HEALTH_DB_PATH=data/tracker_health.db
GEOCODING_DB_PATH=data/geocoding.db
WHATSAPP_DB_PATH=data/whatsapp.db
CORA_WEBHOOK_DB_PATH=data/cora_webhooks.db
