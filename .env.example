# Local portfolio: no accounts or external credentials required.
DEMO_MODE=true
INTEGRATIONS_ENABLED=false
DEMO_EMAIL=demo@portfolio.local
DEMO_PASSWORD=Demo@12345
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
APP_TIMEZONE=America/Sao_Paulo

# Real adapters: require DEMO_MODE=false AND INTEGRATIONS_ENABLED=true.
# Set AUTH_COOKIE_SECURE=true behind HTTPS. Never commit the real .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_REQUEST_TIMEOUT_SECONDS=20
ADMIN_TOKEN=

SELSYN_BASE_URL=https://api.appselsyn.com.br/keek/rest
SELSYN_API_KEY=
HISTORY_AUTO_SYNC=false
POLL_INTERVAL_SECONDS=30
REVERSE_GEOCODING_ENABLED=false
NOMINATIM_USER_AGENT=OperationalPortfolio/1.0

# Optional public contacts. Blank values hide/disable external contact actions.
PUBLIC_CONTACT_EMAIL=contato@example.invalid
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP_URL=
PUBLIC_INSTAGRAM_HANDLE=
PUBLIC_INSTAGRAM_URL=

OPENAI_API_KEY=
HISTORICAL_VISION_MODEL=gpt-4.1

# Banking / billing. No real payment is generated in demo.
CORA_ENABLED=false
CORA_ENVIRONMENT=stage
CORA_CLIENT_ID=
CORA_CERTIFICATE_PATH=
CORA_PRIVATE_KEY_PATH=
CORA_WEBHOOK_TOKEN=
CORA_WEBHOOK_PUBLIC_URL=

# Fiscal integration: all provider data must be explicitly configured.
NFSE_IPM_ENABLED=false
NFSE_IPM_TEST_MODE=true
NFSE_IPM_CITY=
NFSE_IPM_USERNAME=
NFSE_IPM_PASSWORD=
NFSE_PROVIDER_CNPJ=
NFSE_PROVIDER_MUNICIPAL_REGISTRATION=
NFSE_PROVIDER_CITY_CODE=
NFSE_SERVICE_ITEM_CODE=
NFSE_SERVICE_NBS_CODE=
NFSE_SERVICE_TAX_RATE=
NFSE_TAX_SITUATION_CODE=
NFSE_MUNICIPAL_SERVICE_CODE=

WHATSAPP_ENABLED=false
WHATSAPP_AUTO_MENU_ENABLED=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_META_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_MOBILE_SENDER_NAME=Atendimento Demo

# Local paths use data/demo/ automatically in demo; do not point at real data.
SYSTEM_STATE_DB_PATH=data/system_state.db
AUTH_DB_PATH=data/system_auth.db
HISTORY_DB_PATH=data/history.db
DOCUMENTS_ROOT_PATH=data/documents
